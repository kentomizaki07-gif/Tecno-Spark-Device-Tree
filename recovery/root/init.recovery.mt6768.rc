# USB setup for MediaTek MT6768 in recovery.
# Copied from the stock init.recovery.mt6768.rc found in your vendor_boot_a.img.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on fs
    # Tells the USB chip to act as a data port (CDP vs SDP). Same as stock.
    write /sys/class/udc/musb-hdrc/device/cmode 2
